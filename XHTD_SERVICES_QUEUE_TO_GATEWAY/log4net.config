	<root>
		<level value="DEBUG" />
		<appender-ref ref="FileAppender" />
	</root>

	<logger additivity="false" name="ClinkerFileAppender">
		<level value="All"/>
		<appender-ref ref="ClinkerFileAppender" />
	</logger>

	<logger additivity="false" name="Pcb30FileAppender">
