	</appender>
	
	<root>
		<level value="DEBUG" />
		<appender-ref ref="FileAppender" />
	</root>

	<logger additivity="false" name="Machine12FileAppender">
		<level value="All"/>
		<appender-ref ref="Machine12FileAppender" />
	</logger>

	<logger additivity="false" name="Machine34FileAppender">
